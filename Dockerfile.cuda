# NVIDIA Linux x86-64 host only; this upstream image has no ARM64 variant.
ARG CUDA_PLATFORM=linux/amd64
FROM --platform=${CUDA_PLATFORM} pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385
WORKDIR /workspace
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip check
COPY LICENSE .
COPY mcubed mcubed
COPY vendor vendor
COPY configs configs
COPY dashboard dashboard
COPY datasets datasets
COPY tools tools
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "mcubed.doctor"]
